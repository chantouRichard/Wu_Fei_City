			"name": "活动管理",
			"item": [
				{
					"name": "获取开放报名的活动列表",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"状态码应该是 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"响应应该是JSON格式\", function () {",
									"    pm.response.to.be.json;",
									"});",
									"",
									"pm.test(\"响应结构应该正确\", function () {",
									"    const responseJson = pm.response.json();",
									"    pm.expect(responseJson).to.have.property('code');",
									"    pm.expect(responseJson).to.have.property('message');",
									"    pm.expect(responseJson).to.have.property('data');",
									"    pm.expect(responseJson).to.have.property('success');",
									"    pm.expect(responseJson.code).to.eql(200);",
									"    pm.expect(responseJson.success).to.be.true;",
									"});",
									"",
									"pm.test(\"活动数据结构应该正确\", function () {",
									"    const responseJson = pm.response.json();",
									"    if (responseJson.data && responseJson.data.length > 0) {",
									"        const activity = responseJson.data[0];",
									"        pm.expect(activity).to.have.property('activityId');",
									"        pm.expect(activity).to.have.property('title');",
									"        pm.expect(activity).to.have.property('organizerName');",
									"        pm.expect(activity).to.have.property('startTime');",
									"        pm.expect(activity).to.have.property('endTime');",
									"        pm.expect(activity).to.have.property('status');",
									"        pm.expect(activity).to.have.property('imageUrl');",
									"        pm.expect(activity).to.have.property('location');",
									"        pm.expect(activity).to.have.property('avatars');",
									"        pm.expect(activity).to.have.property('participantCount');",
									"        pm.expect(activity).to.have.property('maxParticipants');",
									"        pm.expect(activity.status).to.eql('open');",
									"        pm.expect(activity.avatars).to.be.an('array');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
