        {
            "name": "6. 验证创建的活动 - 查询开放活动列表",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "// 验证响应状态码",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "// 验证新创建的活动在开放列表中",
                            "pm.test(\"Created activity appears in open list\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    var activities = jsonData.data;",
                            "    var createdActivityId = pm.collectionVariables.get('createdActivityId');",
                            "    ",
                            "    if (createdActivityId) {",
                            "        var foundActivity = activities.find(activity => activity.activityId == createdActivityId);",
                            "        pm.expect(foundActivity).to.not.be.undefined;",
                            "        if (foundActivity) {",
                            "            pm.expect(foundActivity.title).to.eql('社区清洁日');",
                            "            pm.expect(foundActivity.status).to.eql('open');",
                            "        }",
                            "    }",
                            "});",
                            "",
                            "console.log('查询验证测试完成');"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/activities/open",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "activities",
                        "open"
                    ]
                }
            }
        }
    ]
