                    "raw": "{\n  \"title\": \"环保知识讲座\",\n  \"description\": \"邀请专家讲解环保知识，提高居民环保意识\",\n  \"signup_end_time_and_activity_start_time\": \"2025-03-01T14:00:00\",\n  \"activity_end_time\": \"2025-03-01T17:00:00\",\n  \"location\": \"社区活动中心\",\n  \"max_participants\": 100,\n  \"image_url\": \"https://cdn.example.com/activities/lecture.jpg\"\n}"
