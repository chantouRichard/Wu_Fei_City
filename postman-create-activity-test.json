        {
            "name": "5. 创建活动 - 完整字段测试",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "// 验证响应状态码",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "// 验证所有字段都正确返回",
                            "pm.test(\"All fields are returned correctly\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    var activity = jsonData.data;",
                            "    ",
                            "    pm.expect(activity.title).to.eql('环保知识讲座');",
                            "    pm.expect(activity.description).to.eql('邀请专家讲解环保知识，提高居民环保意识');",
                            "    pm.expect(activity.location).to.eql('社区活动中心');",
                            "    pm.expect(activity.maxParticipants).to.eql(100);",
                            "    pm.expect(activity.imageUrl).to.include('lecture.jpg');",
                            "    pm.expect(activity.organizerId).to.be.a('number');",
                            "});",
                            "",
                            "console.log('完整字段测试完成');"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
