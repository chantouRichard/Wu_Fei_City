              "        responseJson.data.forEach(avatar => {",
              "            pm.expect(avatar).to.be.a('string');",
              "        });",
              "    }",
              "});",
              "",
              "console.log('参与者头像数量:', responseJson.data.length);",
              "console.log('头像列表:', responseJson.data);"
            ],
            "type": "text/javascript"
          }
        }
      ],
